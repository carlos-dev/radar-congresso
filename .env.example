# Banco de dados (Postgres). Local: docker compose up -d sobe em localhost.
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar"

# Em produção (Vercel + Supabase): use a connection string do POOLER (IPv4),
# NÃO a direta (db.<ref>.supabase.co é IPv6-only e o serverless não alcança).
# Ex.: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true

# URL pública do site (SEO / Open Graph / sitemap). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Portal da Transparência (ingestão de emendas). https://api.portaldatransparencia.gov.br
PORTAL_TRANSPARENCIA_API_KEY=""

# Anthropic (pipeline de tradução de votações em linguagem cidadã).
ANTHROPIC_API_KEY=""

# Supabase (usado para migrar dados para a nuvem). A connection string DIRETA
# serve para rodar migrações/carga a partir de uma máquina com IPv6.
SUPABASE_CONNECTION_STRING=""
