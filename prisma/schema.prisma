generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Casa {
  CAMARA
  SENADO
}

enum Voto {
  SIM
  NAO
  ABSTENCAO
  OBSTRUCAO
  AUSENTE
}

model Parlamentar {
  id          String   @id @default(cuid())
  externalId  String
  casa        Casa
  nome        String
  nomeCivil   String?
  cpf         String?
  partido     String?
  uf          String?
  cargo       String?
  urlFoto     String?
  despesas    Despesa[]
  votos       VotoRegistro[]
  autorias    Autoria[]
  emendas     Emenda[]
  doacoes     Doacao[]
  favorecidos Favorecido[]
  conexoes    Conexao[]
  candidaturas Candidatura[]

  @@unique([casa, externalId])
}

model Candidatura {
  id            String      @id @default(cuid())
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  ano           Int
  cargo         String
  situacao      String? // DS_SITUACAO_CANDIDATURA (APTO / INAPTO...) — elegibilidade
  resultado     String? // DS_SIT_TOT_TURNO (ELEITO / SUPLENTE / NÃO ELEITO)
  patrimonio    Float? // soma dos bens declarados naquela eleição (autodeclarado)
  @@unique([parlamentarId, ano])
  @@index([parlamentarId])
}

model Despesa {
  id             String      @id @default(cuid())
  parlamentar    Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId  String
  ano            Int
  mes            Int
  tipo           String
  fornecedorNome String
  fornecedorDoc  String?
  valor          Float
  @@index([parlamentarId, ano])
}

model Votacao {
  id          String         @id @default(cuid())
  externalId  String         @unique
  casa        Casa           @default(CAMARA)
  data        DateTime
  descricao   String
  votosSim    Int?
  votosNao    Int?
  votosOutros Int?
  tipo        String? // PEC, PLP, PL, MPV, ... (inferido da descrição)
  // Curadoria (híbrido): true força destaque, false oculta, null = heurística.
  destaque    Boolean?
  titulo      String? // rótulo curado em linguagem clara (null = usa a descrição)
  votos       VotoRegistro[]
}

model VotoRegistro {
  id            String      @id @default(cuid())
  votacao       Votacao     @relation(fields: [votacaoId], references: [id])
  votacaoId     String
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  voto          Voto
  @@unique([votacaoId, parlamentarId])
  @@index([parlamentarId])
}

model Proposicao {
  id         String    @id @default(cuid())
  externalId String    @unique
  tipo       String
  ano        Int
  ementa     String
  virouLei   Boolean   @default(false)
  situacao   String? // status de tramitação atual (ultimoStatus_descricaoSituacao)
  autorias   Autoria[]
  @@index([ano])
}

// Autoria (muitos-para-muitos): uma proposição tem vários autores; `principal`
// marca o proponente (1ª assinatura). Distingue produção própria de co-autoria.
model Autoria {
  id            String      @id @default(cuid())
  proposicao    Proposicao  @relation(fields: [proposicaoId], references: [id], onDelete: Cascade)
  proposicaoId  String
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  principal     Boolean     @default(false)
  @@unique([proposicaoId, parlamentarId])
  @@index([parlamentarId, principal])
}

model Emenda {
  id                    String      @id @default(cuid())
  parlamentar           Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId         String
  ano                   Int
  codigoEmenda          String?
  funcao                String?
  municipioBeneficiario String?
  uf                    String?
  beneficiarioDoc       String?
  valorEmpenhado        Float       @default(0)
  valorPago             Float       @default(0)
  @@index([parlamentarId, ano])
}

model Doacao {
  id            String      @id @default(cuid())
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  doadorNome    String
  doadorDoc     String
  valor         Float
  ano           Int
  cargo         String?
  @@index([parlamentarId])
}

model Favorecido {
  id            String      @id @default(cuid())
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  codigoEmenda  String
  doc           String
  nome          String
  tipoPessoa    String      // "PF" | "PJ"
  valorPago     Float
  ano           Int
  @@index([parlamentarId])
  @@index([doc])
}

model Socio {
  id     String @id @default(cuid())
  cnpj   String
  nome   String
  doc    String
  @@unique([cnpj, doc, nome])
  @@index([cnpj])
}

model Conexao {
  id            String      @id @default(cuid())
  parlamentar   Parlamentar @relation(fields: [parlamentarId], references: [id])
  parlamentarId String
  tipo          String      // "DIRETA" | "SOCIO"
  doadorNome    String
  doadorDoc     String
  empresaCnpj   String?
  empresaNome   String?
  valorDoacao   Float
  valorEmenda   Float
  ano           Int
  confianca     String      // "alta" | "media" | "baixa"
  @@index([parlamentarId])
}
